# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
#        -> template "Edit Cloudflare Workers", or a custom token with
#        Account / Cloudflare Pages / Edit.
CLOUDFLARE_API_TOKEN=
# The long id in your Cloudflare dashboard URL:
CLOUDFLARE_ACCOUNT_ID=
